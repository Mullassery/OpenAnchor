# OpenAnchor Configuration
# Copy to .env and fill in values

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=openanchor

# Semantic Cache - Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Privacy
OPENANCHOR_CAPTURE_PROMPTS=false
OPENANCHOR_CAPTURE_RESPONSES=false
